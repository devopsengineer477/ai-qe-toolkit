{
  "servers": {
    "atlassian": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v2/mcp"
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "X-MCP-Toolsets": "repos,issues,pull_requests,actions",
        "X-MCP-Readonly": "true"
      }
    },
    "jenkins": {
      "type": "http",
      "url": "${env:JENKINS_MCP_URL}",
      "headers": {
        "Authorization": "Basic ${env:JENKINS_MCP_BASIC_AUTH}"
      }
    }
  }
}
