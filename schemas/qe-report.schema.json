{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-qe-toolkit/schemas/qe-report.schema.json",
  "title": "AI QE Toolkit Quality Report",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "runs",
    "metrics",
    "release_gates"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "generated_at": {
      "type": "string"
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "metrics": {
      "type": "object"
    },
    "release_gates": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
